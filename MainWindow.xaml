<Window x:Class="LaptopBar.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="LaptopBar" Width="660" Height="64" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
 <Border x:Name="BarSurface" Margin="4" Background="#F51C1933" BorderBrush="#635E92" BorderThickness="1" CornerRadius="15" MouseLeftButtonDown="DragBar">
  <Grid x:Name="BarLayout" Margin="12,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="ModelPanel" Orientation="Horizontal" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal"><Button x:Name="QwenButton" Tag="Qwen" Click="SelectProfile" Padding="8,6" Background="#302B51" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="QwenDot" Width="5" Height="5" Fill="#777384" Margin="0,0,6,0"/><TextBlock Text="Qwen" FontSize="10"/></StackPanel></Button><Button x:Name="OssButton" Tag="Oss" Click="SelectProfile" Padding="8,6" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="OssDot" Width="5" Height="5" Fill="#777384" Margin="0,0,6,0"/><TextBlock Text="Oss" FontSize="10"/></StackPanel></Button><Button x:Name="GptButton" Tag="GPT" Click="SelectProfile" Padding="8,6"><StackPanel Orientation="Horizontal"><TextBlock Text="↗" Foreground="#B8ACFF" Margin="0,0,4,0"/><TextBlock Text="GPT" FontSize="10"/></StackPanel></Button></StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="MetricsPanel" Margin="20,0,24,0">
    <StackPanel Width="78"><StackPanel Orientation="Horizontal"><TextBlock Text="CPU " Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="CpuText" Text="—" FontFamily="Consolas"/></StackPanel><ProgressBar x:Name="CpuBar" Height="2" Maximum="100" Background="#393152" Foreground="#8E80DD" BorderThickness="0" Margin="0,7,13,0"/></StackPanel>
    <StackPanel Width="102"><StackPanel Orientation="Horizontal"><TextBlock Text="RAM " Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="RamText" Text="—" FontFamily="Consolas"/></StackPanel><ProgressBar x:Name="RamBar" Height="2" Maximum="100" Background="#393152" Foreground="#B8ACFF" BorderThickness="0" Margin="0,7,13,0"/></StackPanel>
    <StackPanel x:Name="GpuPanel" Width="78" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="GPU " Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="GpuText" Text="—" FontFamily="Consolas"/></StackPanel><ProgressBar x:Name="GpuBar" Height="2" Maximum="100" Background="#393152" Foreground="#C197E8" BorderThickness="0" Margin="0,7,13,0"/></StackPanel>
   </StackPanel>
   <StackPanel x:Name="RightPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
    <Button x:Name="ConnectionsButton" Click="OpenConnections" Padding="8,9"><StackPanel Orientation="Horizontal"><TextBlock x:Name="WifiGlyph" Text="&#xE701;" FontFamily="Segoe MDL2 Assets" Foreground="#B8ACFF" Margin="0,0,9,0"/><TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" Foreground="#B8ACFF" Margin="0,0,9,0"/><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="#B8ACFF"/></StackPanel></Button>
    <TextBlock x:Name="BatteryText" Text="BAT —" FontFamily="Consolas" Margin="5,0,16,0" Foreground="#C4BEF6"/>
    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="ClockText" Text="00:00" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock x:Name="DateText" Text="MON, NOV 16" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,0" HorizontalAlignment="Right"/></StackPanel>
    <Button x:Name="SettingsButton" Content="···" FontSize="19" Padding="9,4" Click="ShowMenu"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
