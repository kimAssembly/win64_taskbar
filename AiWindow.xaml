<Window x:Class="LaptopBar.AiWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LaptopBar · Local AI" Width="430" Height="580" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12">
<Border Padding="20" CornerRadius="16" Background="#F51C1933" BorderBrush="#635E92" BorderThickness="1"><Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel MouseLeftButtonDown="DragHeader"><Button Content="×" Click="ClosePanel" DockPanel.Dock="Right" Padding="7,0"/><Image x:Name="ModelLogo" Width="23" Height="23" Margin="0,0,11,0" Stretch="Uniform"/><TextBlock x:Name="ProfileTitle" Text="QWEN / PROMPT" Foreground="#C4BEF6" FontSize="10" FontWeight="SemiBold"/></DockPanel>
<Grid Grid.Row="2" Margin="0,16,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Endpoint" Text="http://127.0.0.1:1234/v1" ToolTip="같은 PC의 로컬 OpenAI 호환 서버 주소"/><Button Grid.Column="1" x:Name="ConnectButton" Content="연결" Click="Connect" Background="#494295" Margin="8,0,0,0"/></Grid>
<Grid Grid.Row="3" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
<ComboBox x:Name="Models" MinHeight="28" ToolTip="실제 실행할 모델 선택">
<ComboBox.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1EDFF"/></Style><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#302B51"/><Setter Property="Foreground" Value="#F1EDFF"/></Style></ComboBox.Resources>
<ComboBox.Template><ControlTemplate TargetType="ComboBox"><Grid>
<ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="7" Background="#302B51"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
<ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,5,30,5" IsHitTestVisible="False"/>
<Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="#302B51" CornerRadius="7" Padding="4" MinWidth="280"><ScrollViewer MaxHeight="160"><ItemsPresenter/></ScrollViewer></Border></Popup>
</Grid></ControlTemplate></ComboBox.Template></ComboBox>
<TextBlock Grid.Row="1" x:Name="Status" Text="서버를 시작한 뒤 연결을 눌러주세요." TextWrapping="Wrap" Foreground="#A49BC3" FontSize="10" Margin="0,8,0,0"/></Grid>
<Border Grid.Row="4" Background="#161329" BorderBrush="#393152" BorderThickness="1" CornerRadius="11"><ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" Padding="13"><StackPanel x:Name="Conversation"><TextBlock Text="로컬 모델을 연결하고 질문을 입력하세요.&#10;&#10;실행기에서 모델을 로드하고 API 서버를 시작하면 사용할 수 있어요." Foreground="#A49BC3" TextWrapping="Wrap" FontSize="12" LineHeight="21"/></StackPanel></ScrollViewer></Border>
<TextBox Grid.Row="5" x:Name="Prompt" AcceptsReturn="True" Height="72" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,10" PreviewKeyDown="PromptKey" ToolTip="Ctrl+Enter로 전송"/>
<DockPanel Grid.Row="6"><Button x:Name="SendButton" Content="전송 ↗" Click="Send" DockPanel.Dock="Right" Background="#554CC7" IsEnabled="False"/><Button x:Name="StopButton" Content="중지" Click="Stop" DockPanel.Dock="Right" Visibility="Collapsed"/><Button Content="대화 비우기" Click="Clear" DockPanel.Dock="Left" Padding="0,8"/><TextBlock Text="Ctrl + Enter" FontSize="9" Foreground="#A49BC3" HorizontalAlignment="Center"/></DockPanel>
</Grid></Border></Window>
