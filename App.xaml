<Application x:Class="LaptopBar.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A49BC3"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF0FA"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#DFE7F7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#40365E"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#161329"/><Setter Property="Foreground" Value="#EAF0FA"/><Setter Property="CaretBrush" Value="#B8A6FF"/><Setter Property="BorderBrush" Value="#4B406A"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="24"><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="12" CornerRadius="5,0,0,5"><Border.Background><LinearGradientBrush><GradientStop Color="#397EFF" Offset="0"/><GradientStop Color="#9A83EA" Offset="1"/></LinearGradientBrush></Border.Background></Border></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="7"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#DDD7FF" CornerRadius="3" Height="16"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="12" CornerRadius="0,5,5,0" Background="#40365E"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Application.Resources>
</Application>
