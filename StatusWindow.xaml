<Window x:Class="LaptopBar.StatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LaptopBar · Connections" Width="350" Height="326" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI" FontSize="12">
 <Border Padding="20" CornerRadius="16" Background="#F51C1933" BorderBrush="#635E92" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><Button Content="×" DockPanel.Dock="Right" Click="ClosePanel" Padding="7,0"/><TextBlock Text="QUICK CONNECT" FontSize="10" Foreground="#C4BEF6" FontWeight="SemiBold"/></DockPanel>
   <Grid Grid.Row="1" Margin="0,14,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="WifiTile" Click="WifiSettings" Background="#494295" Margin="0,0,5,0" Padding="8,13" ToolTip="Windows Wi-Fi 설정 열기"><StackPanel><TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center" Margin="0,0,0,8"/><TextBlock Text="Wi-Fi" HorizontalAlignment="Center"/><TextBlock x:Name="WifiState" FontSize="10" Foreground="#D0CCF4" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120" Margin="0,5,0,0"/></StackPanel></Button>
    <Button Grid.Column="1" x:Name="BtTile" Click="BtSettings" Background="#302B51" Margin="5,0,0,0" Padding="8,13" ToolTip="Windows Bluetooth 설정 열기"><StackPanel><TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center" Margin="0,0,0,8"/><TextBlock Text="Bluetooth" HorizontalAlignment="Center"/><TextBlock x:Name="BtState" FontSize="10" Foreground="#D0CCF4" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120" Margin="0,5,0,0"/></StackPanel></Button>
   </Grid>
   <StackPanel Grid.Row="2"><TextBlock x:Name="SpeakerLabel" Text="기본 스피커" FontSize="11" Foreground="#C4BEF6" Margin="0,0,0,6"/><DockPanel><Button Content="&#xE767;" FontFamily="Segoe MDL2 Assets" Click="MuteSpeaker" ToolTip="스피커 음소거 전환" Padding="0,5,10,5"/><TextBlock x:Name="SpeakerValue" DockPanel.Dock="Right" Width="38" TextAlignment="Right" FontSize="11"/><Slider x:Name="SpeakerSlider" Minimum="0" Maximum="100" ValueChanged="SpeakerChanged" Foreground="#A39AFF" VerticalAlignment="Center"/></DockPanel></StackPanel>
   <StackPanel Grid.Row="3" Margin="0,13,0,0"><TextBlock x:Name="MicLabel" Text="기본 마이크" FontSize="11" Foreground="#C4BEF6" Margin="0,0,0,6"/><DockPanel><Button Content="&#xE720;" FontFamily="Segoe MDL2 Assets" Click="MuteMic" ToolTip="마이크 음소거 전환" Padding="0,5,10,5"/><TextBlock x:Name="MicValue" DockPanel.Dock="Right" Width="38" TextAlignment="Right" FontSize="11"/><Slider x:Name="MicSlider" Minimum="0" Maximum="100" ValueChanged="MicChanged" Foreground="#A39AFF" VerticalAlignment="Center"/></DockPanel></StackPanel>
   <TextBlock Grid.Row="4" x:Name="Hint" Text="연결 타일을 누르면 Windows 설정이 열립니다." Foreground="#9E97BD" FontSize="9" Margin="0,15,0,0" TextTrimming="CharacterEllipsis"/>
  </Grid>
 </Border>
</Window>
